rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function untuk memverifikasi autentikasi
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function untuk memverifikasi kepemilikan akun (UID)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Profil Pengguna (Collection: users)
    // Setiap pengguna hanya dapat membaca dan menulis profil miliknya sendiri (UID)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. Data Utama Farm Pengguna (Collection: user_stores)
    // Penyimpanan terisolasi per akun: ikan, kolam, riwayat, dan preferensi
    // Dokumen dinamai sesuai UID pengguna (user_stores/{userId})
    match /user_stores/{userId} {
      allow read, write: if isOwner(userId);

      // Mendukung sub-koleksi jika dikembangkan lebih lanjut (misal: /fishes, /ponds, dll)
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // 3. Marketplace Bersama (Collection: marketplace_products)
    // Semua pengguna yang login dapat melihat produk ikan yang aktif dijual oleh siapa saja (User A, User B, dll)
    // Hanya pemilik produk (berdasarkan userId) yang dapat menambah, mengedit, atau menghapus produk miliknya
    match /marketplace_products/{productId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 4. Blokir semua akses lain secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
