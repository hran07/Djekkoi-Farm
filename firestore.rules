rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function untuk memverifikasi autentikasi
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function untuk memverifikasi kepemilikan akun (UID)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Profil Pengguna (Collection: users)
    // Setiap pengguna hanya dapat membaca dan menulis profil miliknya sendiri (UID)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. Data Utama Farm Pengguna (Collection: user_stores)
    // Penyimpanan terisolasi per akun: ikan, kolam, riwayat, dan preferensi
    // Dokumen dinamai sesuai UID pengguna (user_stores/{userId})
    match /user_stores/{userId} {
      allow read, write: if isOwner(userId);

      // Mendukung sub-koleksi jika dikembangkan lebih lanjut (misal: /fishes, /ponds, dll)
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // 3. Marketplace Bersama (Collection: marketplace_products)
    // Semua pengguna yang login dapat melihat produk ikan yang aktif dijual oleh siapa saja (User A, User B, dll)
    // Hanya pemilik produk (berdasarkan userId) yang dapat menambah, mengedit, atau menghapus produk miliknya
    match /marketplace_products/{productId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 4. Chat Antar Pengguna (Collection: conversations)
    // Percakapan hanya bisa dibuat dari produk marketplace yang valid
    match /conversations/{cid} {
      allow get: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && exists(/databases/$(database)/documents/marketplace_products/$(request.resource.data.productId))
        && get(/databases/$(database)/documents/marketplace_products/$(request.resource.data.productId)).data.userId in request.resource.data.participants;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage','lastMessageAt','lastSenderId']);
      allow delete: if false;

      match /messages/{mid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participants;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // 5. Blokir semua akses lain secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
